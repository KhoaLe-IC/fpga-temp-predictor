set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C35F672C6
set_global_assignment -name TOP_LEVEL_ENTITY de2_weather_jtag
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name SDC_FILE clock.sdc
set_global_assignment -name VERILOG_FILE ../../../../hardware/jtag/jtag_mailbox.v
set_global_assignment -name VERILOG_FILE ../../../../hardware/jtag/jtag_issp.v
set_global_assignment -name VERILOG_FILE ../../../../hardware/jtag/de2_weather_jtag.v
set_global_assignment -name VERILOG_FILE ../../../../hardware/speed_optimized/reset_sync.v
set_global_assignment -name VERILOG_FILE ../../rtl/weather_system_speed.v
set_global_assignment -name VERILOG_FILE ../../rtl/weather_predictor_speed.v
set_global_assignment -name VERILOG_FILE ../../rtl/wind_direction_cordic.v
set_global_assignment -name VERILOG_FILE ../../rtl/weather_ar_channel.v
set_location_assignment PIN_N2 -to CLOCK_50
# KEY1 fallback authorized by user: logical KEY0_N now uses physical KEY[1] (N23).
set_location_assignment PIN_N23 -to KEY0_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY0_N
set_parameter -name SHARED 0

set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"