# Weather window -> LCD variant of de2_jtag_speed. Original DE2 / EP2C35F672C6.
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C35F672C6
set_global_assignment -name TOP_LEVEL_ENTITY de2_weather_lcd
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name SDC_FILE clock.sdc
set_global_assignment -name VERILOG_FILE ../../lcd/rtl/de2_weather_lcd.v
set_global_assignment -name VERILOG_FILE ../../lcd/rtl/weather_lcd_text.v
set_global_assignment -name VERILOG_FILE ../../lcd/rtl/lcd_hd44780.v
set_global_assignment -name VERILOG_FILE ../../../../hardware/jtag/jtag_mailbox.v
set_global_assignment -name VERILOG_FILE ../../../../hardware/jtag/jtag_issp.v
set_global_assignment -name VERILOG_FILE ../../../../hardware/speed_optimized/reset_sync.v
set_global_assignment -name VERILOG_FILE ../../rtl/weather_system_speed.v
set_global_assignment -name VERILOG_FILE ../../rtl/weather_predictor_speed.v
set_global_assignment -name VERILOG_FILE ../../rtl/wind_direction_cordic.v
set_global_assignment -name VERILOG_FILE ../../rtl/weather_ar_channel.v
set_location_assignment PIN_N2 -to CLOCK_50
set_location_assignment PIN_G26 -to KEY0_N
set_location_assignment PIN_J1 -to LCD_DATA[0]
set_location_assignment PIN_J2 -to LCD_DATA[1]
set_location_assignment PIN_H1 -to LCD_DATA[2]
set_location_assignment PIN_H2 -to LCD_DATA[3]
set_location_assignment PIN_J4 -to LCD_DATA[4]
set_location_assignment PIN_J3 -to LCD_DATA[5]
set_location_assignment PIN_H4 -to LCD_DATA[6]
set_location_assignment PIN_H3 -to LCD_DATA[7]
set_location_assignment PIN_K1 -to LCD_RS
set_location_assignment PIN_K3 -to LCD_EN
set_location_assignment PIN_K4 -to LCD_RW
set_location_assignment PIN_L4 -to LCD_ON
set_location_assignment PIN_K2 -to LCD_BLON
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY0_N
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LCD_DATA[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LCD_RS
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LCD_EN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LCD_RW
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LCD_ON
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LCD_BLON
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
